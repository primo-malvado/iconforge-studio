{
  "name": "iconforge-studio",
  "version": "0.11.0",
  "description": "Project-local SVG icon library manager and generator",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "npm run test && npm run lint",
    "lint": "node --check bin/iconforge.js core.js server.js fontgen.js",
    "test": "node --test",
    "iconforge": "node bin/iconforge.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "svg-pathdata": "^9.0.0",
    "svg2ttf": "^6.1.0",
    "svgo": "^3.3.2",
    "woff2-encode-wasm": "^0.1.1"
  },
  "bin": {
    "iconforge": "./bin/iconforge.js"
  },
  "files": [
    "bin/",
    "public/",
    "core.js",
    "server.js",
    "fontgen.js",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
